# Dockerfile

# Use Node.js to build the Angular app
FROM node:20-alpine AS build

# Install build dependencies (for native dependencies)
RUN apk add --no-cache bash \
    && npm install -g nx

WORKDIR /app

# Copy package.json and install dependencies
COPY package.json package-lock.json ./

RUN npm install --no-audit

# Copy the rest of your app code
COPY . .

# Build the app with nx
RUN npx nx build lab --prod

# Serve the Angular app with NGINX
FROM nginx:alpine

# Copy the build output to NGINX's public directory
COPY --from=build /app/dist/apps/lab /usr/share/nginx/html

# Create directory for Django media files
RUN mkdir -p /usr/share/nginx/media

# Copy custom nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy and make entrypoint executable
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Expose port and set entrypoint
EXPOSE 80

ENTRYPOINT ["/docker-entrypoint.sh"]
